# Android tools
ADB_PATH=adb
SCRCPY_PATH=scrcpy
ANDROID_SERIAL=

# Agent virtual display
AGENT_DISPLAY_SIZE=1080x2400
AGENT_DISPLAY_DPI=420
AGENT_START_COMPONENT=com.shadowtasks.agent/com.shadowtasks.MainActivity
AGENT_APP_NAME=Shadow Tasks

# OpenAI-compatible AutoGLM endpoint
PHONE_AGENT_BASE_URL=http://localhost:8000/v1
PHONE_AGENT_API_KEY=EMPTY
PHONE_AGENT_MODEL=autoglm-phone-9b
PHONE_AGENT_MAX_STEPS=40

# Safety and observation
ALLOW_MAIN_DISPLAY_CAPTURE=false
HUMAN_OBSERVER_ALLOW_PACKAGES=com.shadowtasks.user
AGENT_ACTION_DELAY_MS=1200
# Enable on phones whose Chinese IME composes ASCII sent by `adb input text`.
AGENT_SWITCH_IME_TO_ENGLISH_BEFORE_TYPE=false
# Optional app-specific Intent extra used to bypass vendor IME composition.
AGENT_TEXT_INPUT_EXTRA=
AGENT_ARTIFACT_DIR=.shadow-agent

# Demo verifier/backend
DEMO_API_URL=http://127.0.0.1:8787
DEMO_API_TOKEN=demo-local-token
